---
import PageContainer from '../layout/PageContainer.astro';
import { Separator } from '@/components/ui/separator';
import logoWhite from '@/assets/brand/analyteqc-logo-all-wite.svg';
import IsoBadge from './pieces/IsoBadge.astro';
import { contactLinks, demoCta, sectionLinks } from '@/config/navigation';
---

<!-- Footer oscuro: brand-950 (azul marca profundo) con logo blanco; textos en blanco con opacidades para jerarquía -->
<footer class="w-full bg-brand-950 py-14 text-neutral-0/80 sm:py-16">
  <PageContainer width="content">
    <!-- 1 col móvil · 2 col sm · 5/3/4 desde md -->
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-12 lg:gap-10">
      <div class="flex flex-col items-start sm:col-span-2 md:col-span-5">
        <a href="/" class="inline-flex" aria-label="AnalyteQC - Inicio">
          <img src={logoWhite.src} alt="AnalyteQC" class="h-9 w-auto" width="193" height="36" />
        </a>
        <!-- Eslogan: resume la promesa del Hero (liberar resultados con confianza en cada corrida) -->
        <p class="mt-5 max-w-[22rem] text-lg font-normal leading-snug text-neutral-0">
          Resultados confiables en cada corrida.
        </p>
        <IsoBadge class="mt-6" />
      </div>

      <nav class="md:col-span-3" aria-label="Enlaces útiles">
        <h4 class="text-base font-semibold text-neutral-0">Enlaces útiles</h4>
        <ul class="mt-4 space-y-3 text-base">
          {sectionLinks.map((link) => (
            <li><a href={link.href} class="transition-colors hover:text-neutral-0">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="md:col-span-4">
        <h4 class="text-base font-semibold text-neutral-0">Demostración y contacto</h4>
        <ul class="mt-4 space-y-3 text-base">
          <li>
            <a href={demoCta.href} class="font-medium text-accent-turquoise transition-colors hover:text-neutral-0">→ Agendar Demostración</a>
          </li>
          {contactLinks.map((link) => (
            <li><a href={link.href} class="transition-colors hover:text-neutral-0">{link.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <Separator className="mt-12 bg-neutral-0/15" />

    <div class="flex justify-center pt-6 text-center text-sm text-neutral-0/60">
      <p>&copy; 2026 AnalyteQC · Pital, Huila, Colombia</p>
    </div>
  </PageContainer>
</footer>
