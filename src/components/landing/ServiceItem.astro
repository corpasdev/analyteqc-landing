---
interface Props {
  iconType: 'shield' | 'chart' | 'flask' | 'team';
  title: string;
  description: string;
  class?: string;
}

const { iconType, title, description, class: className = '' } = Astro.props;
---

<div class:list={['flex flex-col items-center text-center px-4 py-2', className]}>
  <!-- Tile del Icono (104 × 104 px, radio 25 px, fondo primary-50, shadow-sm) -->
  <div
    class="flex h-[104px] w-[104px] items-center justify-center rounded-[25px] bg-primary-50 text-primary-500 shadow-[0_4px_16px_rgba(31,56,146,0.06)] transition-transform duration-300 hover:scale-105"
  >
    {
      iconType === 'shield' && (
        <svg
          class="h-[50px] w-[50px]"
          viewBox="0 0 50 50"
          fill="none"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            d="M25 4 L44 11 V23 C44 34.5 36 44 25 48 C14 44 6 34.5 6 23 V11 Z"
            stroke-width="2.5"
            stroke-linejoin="round"
          />
          <path
            d="M16 24 L22 30 L34 18"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      )
    }

    {
      iconType === 'chart' && (
        <svg
          class="h-[50px] w-[50px]"
          viewBox="0 0 50 50"
          fill="none"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path d="M6 44 H44" stroke-width="2.5" stroke-linecap="round" />
          <rect x="10" y="24" width="7" height="20" rx="2" stroke-width="2.5" />
          <rect x="21" y="14" width="7" height="30" rx="2" stroke-width="2.5" />
          <rect x="32" y="6" width="7" height="38" rx="2" stroke-width="2.5" />
        </svg>
      )
    }

    {
      iconType === 'flask' && (
        <svg
          class="h-[50px] w-[50px]"
          viewBox="0 0 50 50"
          fill="none"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path d="M20 6 H30" stroke-width="2.5" stroke-linecap="round" />
          <path
            d="M22 6 V16 L10 38 C8 41.5 10.5 45 14.5 45 H35.5 C39.5 45 42 41.5 40 38 L28 16 V6"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path d="M15 32 H35" stroke-width="2.5" stroke-linecap="round" />
        </svg>
      )
    }

    {
      iconType === 'team' && (
        <svg
          class="h-[50px] w-[50px]"
          viewBox="0 0 50 50"
          fill="none"
          stroke="currentColor"
          aria-hidden="true"
        >
          <circle cx="20" cy="16" r="6" stroke-width="2.5" />
          <path
            d="M10 36 C10 30.5 14.5 27 20 27 C25.5 27 30 30.5 30 36"
            stroke-width="2.5"
            stroke-linecap="round"
          />
          <circle cx="33" cy="18" r="5" stroke-width="2.5" />
          <path
            d="M33 27 C36.5 27 40 29.5 40 34"
            stroke-width="2.5"
            stroke-linecap="round"
          />
        </svg>
      )
    }
  </div>

  <!-- Título a 35 px bajo el tile (22px / 600 / brand-900) -->
  <h3 class="mt-[35px] text-[22px] font-semibold tracking-tight text-brand-900">
    {title}
  </h3>

  <!-- Descripción a 10 px (19px / 400 / interlineado 29px / neutral-500, max-w ≈ 240px) -->
  <p class="mt-[10px] max-w-[240px] text-[19px] font-normal leading-[29px] text-neutral-500">
    {description}
  </p>
</div>
