---
import Container from './Container.astro';

interface Props {
  id?: string;
  spacing?: 'sm' | 'md' | 'lg' | 'none';
  containerSize?: 'layout' | 'content' | 'narrow' | 'chart' | 'table' | 'full';
  withContainer?: boolean;
  class?: string;
}

const {
  id,
  spacing = 'md',
  containerSize = 'layout',
  withContainer = true,
  class: className = '',
  ...rest
} = Astro.props;

const spacingClasses = {
  sm: 'py-8 sm:py-12 md:py-16',
  md: 'py-14 sm:py-20 md:py-24 lg:py-28',
  lg: 'py-20 sm:py-28 md:py-32 lg:py-36',
  none: 'py-0',
};
---

<section
  id={id}
  class:list={[
    'relative w-full',
    spacingClasses[spacing],
    className,
  ]}
  {...rest}
>
  {
    withContainer ? (
      <Container size={containerSize}>
        <slot />
      </Container>
    ) : (
      <slot />
    )
  }
</section>
